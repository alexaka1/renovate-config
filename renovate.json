{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>alexaka1/renovate-config"
  ],
  "constraints": {
    "bun": "1.3.14"
  },
  "packageRules": [
    {
      "description": "Keep .bun-version and constraints.bun on the same Bun release",
      "matchManagers": [
        "bun-version",
        "renovate-config"
      ],
      "matchPackageNames": [
        "bun",
        "oven-sh/bun"
      ],
      "groupName": "bun"
    }
  ]
}
